{
  "name": "drerer",
  "version": "0.0.2",
  "description": "Draw things",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drerer.esm.js",
      "require": "./dist/drerer.cjs",
      "default": "./dist/drerer.esm.js"
    },
    "./min": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drerer.esm.min.js",
      "require": "./dist/drerer.cjs.min.cjs",
      "default": "./dist/drerer.esm.min.js"
    },
    "./umd": {
      "default": "./dist/drerer.umd.js"
    },
    "./umd/min": {
      "default": "./dist/drerer.umd.min.js"
    },
    "./fill": {
      "types": "./dist/fill/index.d.ts",
      "import": "./dist/drerer.fill.esm.js",
      "require": "./dist/drerer.fill.cjs",
      "default": "./dist/drerer.fill.esm.js"
    }
  },
  "main": "dist/drerer.cjs",
  "module": "dist/drerer.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/drerer.umd.min.js",
  "jsdelivr": "dist/drerer.umd.min.js",
  "directories": {
    "example": "example",
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js,mjs}\"",
    "test": "npm run build && npm run test:package && npm run test:browser",
    "test:package": "node --test test/package.test.mjs",
    "test:browser": "esbuild ./test/index.ts --bundle | tapout",
    "build": "node scripts/build.mjs",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && VITE_DEBUG_MODE=staging vite --mode staging --base=\"/repo-name\" build",
    "build-docs": "typedoc ./src/index.ts",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@substrate-system/debug": "^0.9.64",
    "@substrate-system/tapout": "^0.0.42",
    "@substrate-system/tapzero": "^0.10.16",
    "auto-changelog": "^2.4.0",
    "browserslist": "^4.28.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.6.0",
    "htm": "^3.1.1",
    "lightningcss": "^1.30.2",
    "markdown-toc": "^1.2.0",
    "newneostandard": "^0.14.1",
    "nightralph": "^0.0.52",
    "preact": "^10.29.3",
    "tap-spec": "^5.0.0",
    "typedoc": "^0.28.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "keywords": [
    "draw",
    "atrament",
    "canvas"
  ],
  "homepage": "https://github.com/nichoth/drerer",
  "bugs": {
    "url": "https://github.com/nichoth/drerer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichoth/drerer.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
